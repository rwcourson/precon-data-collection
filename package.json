{
  "name": "precon-data-collection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:migrate:deploy": "tsx src/db/migrate-deploy.ts",
    "db:migrate:check": "tsx src/db/migration-check.ts",
    "db:demo:bootstrap": "tsx src/db/bootstrap-demo.ts",
    "db:bootstrap:smartsheet": "tsx src/db/bootstrap-smartsheet.ts",
    "tokens:revoke-demo": "node --conditions=react-server --import tsx src/db/revoke-demo-tokens.ts",
    "db:seed": "pnpm run db:demo:bootstrap",
    "db:import-smartsheet": "tsx --env-file=.env.local src/db/seed-from-smartsheet.ts",
    "db:seed-sheets": "tsx --env-file=.env.local src/db/seed-sheets-cli.ts",
    "smartsheet:pull": "node --env-file=.env.local scripts/pull-smartsheet.mjs",
    "smartsheet:dump-counts": "tsx scripts/smartsheet-dump-counts.ts",
    "smartsheet:live-counts": "tsx scripts/smartsheet-live-counts.ts",
    "smartsheet:dump-report": "node scripts/smartsheet-dump-report.mjs",
    "lucy:frozen-report": "tsx scripts/frozen-fixture-report.ts",
    "ops:signoff-status": "node scripts/operational-signoff-status.mjs",
    "warehouse:readiness": "node scripts/warehouse-readiness.mjs",
    "databricks:probe": "node --env-file=.env.local scripts/probe-databricks.mjs",
    "db:reset": "pnpm run db:demo:bootstrap",
    "db:status": "tsx --env-file=.env.local src/db/db-status.ts",
    "dev:demo": "node --env-file=.env.example ./node_modules/next/dist/bin/next dev",
    "smoke": "node scripts/smoke.mjs",
    "smoke:approval": "node scripts/run-isolated-smoke.mjs --approval-only",
    "roundtable:phase-status": "node scripts/roundtable-phase-status.mjs",
    "smoke:isolated": "node scripts/run-isolated-smoke.mjs",
    "audit:ui": "node scripts/run-isolated-ui-audit.mjs",
    "mobile": "pnpm --filter mobile start",
    "mobile:typecheck": "pnpm --filter mobile run typecheck",
    "mobile:typecheck:verify": "node scripts/verify-mobile-typecheck.mjs",
    "mobile:test": "pnpm --filter mobile test",
    "mobile:bundle": "pnpm --filter mobile run bundle:ios",
    "verify:web": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run smoke:isolated",
    "verify:restore": "node scripts/verify-restore.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "contract:generate": "node scripts/generate-openapi.mjs",
    "contract:check": "node scripts/contract-check.mjs",
    "perf:check": "node scripts/perf-check.mjs",
    "security:check": "node scripts/security-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "e2e": "pnpm run smoke:isolated",
    "verify:expo": "pnpm run mobile:typecheck:verify && pnpm run mobile:test && pnpm run mobile:bundle",
    "verify:ios": "node scripts/verify-ios.mjs",
    "verify:all": "pnpm run verify:web && pnpm run verify:expo && pnpm run verify:ios",
    "charts:sync": "node scripts/sync-chart-elements.mjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.45",
    "@ai-sdk/react": "^4.0.61",
    "@base-ui/react": "^1.7.0",
    "@better-auth/cimd": "^1.7.1",
    "@better-auth/mcp": "^1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@electric-sql/pglite": "^0.5.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "@rwcourson/chart-elements": "file:vendor/chart-elements",
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.58",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "eve": "^0.38.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "playwright-core": "^1.62.1",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "jszip": "3.10.1",
    "playwright": "^1.62.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
