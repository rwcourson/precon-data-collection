{
  "name": "precon-data-collection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:import-smartsheet": "tsx --env-file=.env.local src/db/seed-from-smartsheet.ts",
    "db:seed-sheets": "tsx --env-file=.env.local src/db/seed-sheets-cli.ts",
    "smartsheet:pull": "node --env-file=.env.local scripts/pull-smartsheet.mjs",
    "databricks:probe": "node --env-file=.env.local scripts/probe-databricks.mjs",
    "db:reset": "rm -rf .pglite && mkdir -p .pglite && npm run db:push && npm run db:seed",
    "db:reset:smartsheet": "rm -rf .pglite && mkdir -p .pglite && npm run db:push && npm run db:import-smartsheet",
    "smoke": "node scripts/smoke.mjs",
    "smoke:approval": "node scripts/verify-approval.mjs",
    "audit:ui": "node scripts/ui-audit.mjs",
    "mobile": "npm --prefix apps/mobile start",
    "mobile:typecheck": "npm --prefix apps/mobile exec tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.45",
    "@base-ui/react": "^1.7.0",
    "@electric-sql/pglite": "^0.5.4",
    "ai": "^7.0.57",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
