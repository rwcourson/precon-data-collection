{
  "name": "@rwcourson/chart-elements",
  "version": "0.1.0",
  "description": "Composable, themeable React data-visualization elements inspired by modern BI interfaces.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SBOM.cdx.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./charts/bar-column": {
      "types": "./dist/charts/bar-column.d.ts",
      "import": "./dist/charts/bar-column.js"
    },
    "./charts/line-area": {
      "types": "./dist/charts/line-area.d.ts",
      "import": "./dist/charts/line-area.js"
    },
    "./charts/frame": {
      "types": "./dist/charts/frame.d.ts",
      "import": "./dist/charts/frame.js"
    },
    "./cards": {
      "types": "./dist/cards.d.ts",
      "import": "./dist/cards.js"
    },
    "./tables": {
      "types": "./dist/tables.d.ts",
      "import": "./dist/tables.js"
    },
    "./slicers": {
      "types": "./dist/slicers.d.ts",
      "import": "./dist/slicers.js"
    },
    "./maps": {
      "types": "./dist/maps.d.ts",
      "import": "./dist/maps.js"
    },
    "./reports": {
      "types": "./dist/reports.d.ts",
      "import": "./dist/reports.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./shapes": {
      "types": "./dist/shapes.d.ts",
      "import": "./dist/shapes.js"
    },
    "./overlays": {
      "types": "./dist/overlays.d.ts",
      "import": "./dist/overlays.js"
    },
    "./declarative": {
      "types": "./dist/declarative.d.ts",
      "import": "./dist/declarative.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js"
    },
    "./integrations": {
      "types": "./dist/integrations.d.ts",
      "import": "./dist/integrations.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./ui/button": {
      "types": "./dist/ui/button.d.ts",
      "import": "./dist/ui/button.js"
    },
    "./sample-data": {
      "types": "./dist/sample-data.d.ts",
      "import": "./dist/sample-data.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css",
    "./tokens.css": "./dist/tokens.css",
    "./palettes.css": "./dist/palettes.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/mark-client.mjs && tailwindcss -i styles/components.input.css -o dist/components.raw.css --minify && node scripts/build-styles.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "validate": "publint && node ../../scripts/run-attw.mjs --pack . --profile esm-only --entrypoints . ./charts ./charts/bar-column ./charts/line-area ./charts/frame ./cards ./tables ./slicers ./maps ./reports ./analytics ./navigation ./shapes ./overlays ./declarative ./content ./integrations ./ui ./ui/button ./sample-data"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "lucide-react": "^1.30.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vega": "^6.3.1",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwcourson/chart-elements.git",
    "directory": "packages/chart-elements"
  },
  "homepage": "https://chart-elements.vercel.app",
  "bugs": {
    "url": "https://github.com/rwcourson/chart-elements/issues"
  },
  "keywords": [
    "react",
    "charts",
    "data-visualization",
    "dashboard",
    "business-intelligence",
    "recharts",
    "d3"
  ]
}
