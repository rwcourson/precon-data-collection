# Runtime identity. Every deployment must select each mode explicitly.
APP_ENV=demo
APP_ORIGIN=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000

# Authentication: demo is local/demo only; production requires sso (Better Auth + Microsoft).
AUTH_MODE=demo
SSO_ALLOWED_DOMAINS=brasfieldgorrie.com
# Better Auth (required when AUTH_MODE=sso)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Optional legacy authenticating-proxy trust (not required for Microsoft SSO)
SSO_TRUST_SECRET=
SSO_EMAIL_HEADER=x-forwarded-email
SSO_NAME_HEADER=x-forwarded-preferred-username
SSO_GROUPS_HEADER=x-forwarded-groups

# Database: PGlite is local/demo only. Production uses postgres and both URLs.
DATABASE_MODE=pglite
PGLITE_DATA_DIR=.pglite/data
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Scheduler and delivery. Production requires a 32+ character cron secret.
CRON_SECRET=
API_TOKEN_MAX_TTL_DAYS=90
EMAIL_MODE=stub
RESEND_API_KEY=
EMAIL_FROM=precon@example.com

# Private report storage. Production requires vercel-blob.
PRIVATE_STORAGE_MODE=local
BLOB_READ_WRITE_TOKEN=

# External integrations. Disabled is explicit; production never infers mocks.
CONNECT_MODE=mock
CONNECT_API_URL=
CONNECT_API_TOKEN=
SMARTSHEET_MODE=disabled
SMARTSHEET_ACCESS_TOKEN=
DATABRICKS_MODE=disabled
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
