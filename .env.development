# Local Next.js development defaults (committed).
# Override secrets and production URLs in .env.local — that file wins when both set a key.
# Demo seed (`pnpm run db:reset`) always forces PGlite and ignores hosted DATABASE_URL.

APP_ENV=demo
AUTH_MODE=demo
DATABASE_MODE=pglite
PGLITE_DATA_DIR=.pglite/data
APP_ORIGIN=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000
EMAIL_MODE=stub
PRIVATE_STORAGE_MODE=local
CONNECT_MODE=mock
SMARTSHEET_MODE=disabled
DATABRICKS_MODE=disabled
API_TOKEN_MAX_TTL_DAYS=90
